dist/
scripts/.scan-tools/
*.tsbuildinfo

# Dependencies
node_modules/

# Package manager lock files — commit the one your package manager uses.
# package-lock.json is intentionally NOT ignored (npm ci / setup-node need it).
yarn.lock
pnpm-lock.yaml

# Environment files
.env
.env.local
.env.*.local

