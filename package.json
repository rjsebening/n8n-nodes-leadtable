{
  "name": "n8n-nodes-leadtable",
  "version": "1.0.15",
  "description": "n8n custom node for LeadTable API - Lead management and webhook automation",
  "license": "MIT",
  "homepage": "https://github.com/rjsebening/n8n-nodes-leadtable#readme",
  "author": {
    "name": "Jörg Sebening",
    "email": "dev@joerg-sebening.com"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "leadtable",
    "lead-management",
    "webhook",
    "automation",
    "crm",
    "workflow"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rjsebening/n8n-nodes-leadtable.git"
  },
  "bugs": {
    "url": "https://github.com/rjsebening/n8n-nodes-leadtable/issues"
  },
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "build": "npx rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "lint:node": "n8n-node lint",
    "lint:all": "npm run lint && npm run lint:node",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/LeadTableApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/LeadTable/LeadTable.node.js",
      "dist/nodes/LeadTable/LeadTableTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.23.1",
    "@typescript-eslint/parser": "^8.52.0",
    "eslint": "^9.39.4",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "gulp-cli": "^3.1.0",
    "package-json-from-dist": "^1.0.1",
    "prettier": "^3.8.1",
    "release-it": "^19.2.4",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
